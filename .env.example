# ── Database ────────────────────────────────────────────────
# Postgres. Prisma 7 reads this via prisma.config.ts.
DATABASE_URL="postgresql://skelmet:skelmet@localhost:5432/skelmet?schema=public"

# ── Auth.js v5 ──────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Payments ────────────────────────────────────────────────
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# ── Mail ────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SKELMET <hello@skelmet.in>"

# ── Cron ────────────────────────────────────────────────────
CRON_SECRET=""
DISABLE_INLINE_SCHEDULER=""

# Set to 1 once Postgres and Auth.js are wired up — boot then fails fast on a
# missing DATABASE_URL or AUTH_SECRET, as dn-nextjs-standard §6 intends.
REQUIRE_BACKEND=""
