# SKELMET - copy to `.env` and fill in. Never commit `.env` itself.
#
# `lib/env.ts` validates all of this with Zod and is imported by
# `instrumentation.ts`, so a bad value fails the boot rather than the first
# request that happens to need it (§6).

# ---------------------------------------------------------------------------
# Database - Postgres. Prisma 7 talks to it through the `pg` driver adapter.
#
# Migrations are hand-written SQL applied with `pnpm db:migrate`
# (`prisma migrate deploy`), never `migrate dev`: that needs shadow-database
# rights most hosted Postgres refuses (§6).
#
# Local development, after `winget install PostgreSQL.PostgreSQL.17`:
#   postgresql://skelmet:<password>@127.0.0.1:5432/skelmet?schema=public
# ---------------------------------------------------------------------------
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Auth.js v5. Sessions are JWTs, so AUTH_SECRET is what signs them - rotating
# it signs everyone out.
#
#   openssl rand -base64 32
#
# AUTH_URL must match the origin you actually browse, port included, or the
# sign-in callback bounces back to the login page without an error.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payments - Razorpay, over their REST API directly (no SDK).
#
# Without the key pair, checkout refuses ONLINE up front and offers cash on
# delivery instead; it does not silently pretend to take a payment.
#
# PAYMENT_WEBHOOK_SECRET is a SEPARATE value from the key secret - it is shown
# once when you add the webhook in the Razorpay dashboard. Webhook verification
# fails closed without it, so every delivery is rejected and orders are only
# ever confirmed by the browser's return trip (§6).
# ---------------------------------------------------------------------------
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Shipping - Shiprocket, over their REST API directly (no SDK).
#
# The login is an API user (Shiprocket > Settings > API > API Users), whose
# email must differ from the main Shiprocket login. Without these the console
# falls back to typing the courier and AWB by hand.
#
# SHIPROCKET_API_URL: https://apiv2.shiprocket.in for live,
# https://api-sandbox.shiprocket.in for the sandbox (Settings > Sandbox).
#
# SHIPROCKET_PICKUP_LOCATION is the NAME of a pickup address added in
# Shiprocket (Settings > Pickup Addresses), exactly as written there. Orders
# cannot be created in Shiprocket until one exists.
#
# SHIPROCKET_WEBHOOK_TOKEN: any long random string. Paste the same value as the
# security token in Shiprocket > Settings > API > Webhooks, with the URL
# https://<host>/api/public/webhooks/shipping. Tracking updates that do not
# carry it are ignored.
#
# Quote the password in single quotes if it has # or $ in it, and write each
# $ as \$ - an unquoted # starts a comment, and $ starts a variable.
# ---------------------------------------------------------------------------
SHIPROCKET_API_URL="https://apiv2.shiprocket.in"
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------------------
# Mail. REQUIRED IN PRODUCTION: customers have no accounts, so the order
# confirmation is the only record they keep of their order number - and that
# number plus their email is what /track asks for. With SMTP_HOST empty the
# mailer no-ops, orders still complete, and buyers are left with nothing.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SKELMET <skelmetindia@gmail.com>"

# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER the full address
# and SMTP_PASSWORD a 16-character App Password (not the account password; it
# needs 2-Step Verification switched on). MAIL_FROM MUST be that same mailbox
# or a verified "Send mail as" alias - Gmail will not send as an address it
# cannot prove you own, so pointing this at orders@skelmet.in before that alias
# exists gets the message rejected. Free Gmail also caps sending near 500
# recipients a day, which is a ceiling worth knowing before a launch.

# ---------------------------------------------------------------------------
# Scheduled work. `assertCron` compares this in constant time and fails closed
# when it is unset, so an unconfigured deploy cannot have its jobs triggered.
# ---------------------------------------------------------------------------
CRON_SECRET=""
DISABLE_INLINE_SCHEDULER=""

# ---------------------------------------------------------------------------
# The backend switch. With "1", DATABASE_URL and AUTH_SECRET become required
# and boot fails without them. Leave it empty only to run the marketing pages
# with no database at all.
# ---------------------------------------------------------------------------
REQUIRE_BACKEND="1"

# ---------------------------------------------------------------------------
# Seed only, read by `prisma/seed.ts`. `pnpm db:seed` is DESTRUCTIVE - it wipes
# the catalogue, roles and permissions. Never point it at a live database; use
# `pnpm db:sync-permissions` for permission changes instead (§6).
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@skelmet.in"
SEED_ADMIN_PASSWORD="skelmet-dev"
SEED_I_KNOW_WHAT_I_AM_DOING=""
