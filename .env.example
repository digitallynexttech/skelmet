# SKELMET - copy to `.env` and fill in. Never commit `.env` itself.
#
# `lib/env.ts` validates all of this with Zod and is imported by
# `instrumentation.ts`, so a bad value fails the boot rather than the first
# request that happens to need it (§6).
#
# Copied as it is, this boots the storefront with no database: the marketing
# and product pages work from the catalogue registry, and anything that needs
# the database (checkout, the console) answers 503. An empty value counts as
# unset, but the optional ones below are commented out so it is obvious which
# are still to fill in. Uncomment a line when you give it a value.

# ---------------------------------------------------------------------------
# Database - Postgres. Prisma 7 talks to it through the `pg` driver adapter.
#
# Migrations are hand-written SQL applied with `pnpm db:migrate`
# (`prisma migrate deploy`), never `migrate dev`: that needs shadow-database
# rights most hosted Postgres refuses (§6).
#
# Local development, after `winget install PostgreSQL.PostgreSQL.17`:
#   postgresql://skelmet:<password>@127.0.0.1:5432/skelmet?schema=public
#
# Setting DATABASE_URL makes AUTH_SECRET required: boot fails without it.
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://skelmet:<password>@127.0.0.1:5432/skelmet?schema=public"

# ---------------------------------------------------------------------------
# Auth.js v5. Sessions are JWTs, so AUTH_SECRET is what signs them - rotating
# it signs everyone out, and makes the secrets saved in Settings unreadable
# (they are sealed with a key derived from it) until they are entered again.
#
#   openssl rand -base64 32
#
# AUTH_URL must match the origin you actually browse, port included, or the
# sign-in callback bounces back to the login page without an error. In
# production it is https://skelmet.in - it also decides whether the session
# cookie is a Secure one, which proxy.ts has to agree with.
# ---------------------------------------------------------------------------
# AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# The site's own address: links in emails, the webhook URLs Settings shows,
# and whether cookies are Secure. Boot logs an error in production when it is
# missing or points at localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payments - Razorpay, over their REST API directly (no SDK).
#
# The keys can also be saved in the console (Settings > Payments), which
# wins over these. Without a key pair for the account switched on, checkout
# refuses to take the order and says payments are unavailable - there is no
# cash on delivery to fall back to (it was withdrawn), and checkout never
# pretends to take a payment.
#
# PAYMENT_WEBHOOK_SECRET is a SEPARATE value from the key secret - it is shown
# once when you add the webhook in the Razorpay dashboard. Webhook verification
# fails closed without it, so every delivery is rejected and orders are only
# ever confirmed by the browser's return trip (§6).
# ---------------------------------------------------------------------------
# PAYMENT_KEY_ID="rzp_test_..."
# PAYMENT_KEY_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Shipping - Shiprocket, over their REST API directly (no SDK).
#
# The login is an API user (Shiprocket > Settings > API > API Users), whose
# email must differ from the main Shiprocket login. Without these the console
# falls back to typing the courier and AWB by hand. They can also be saved in
# the console (Settings > Shiprocket).
#
# SHIPROCKET_API_URL: https://apiv2.shiprocket.in for live,
# https://api-sandbox.shiprocket.in for the sandbox (Settings > Sandbox).
#
# SHIPROCKET_PICKUP_LOCATION is the NAME of a pickup address added in
# Shiprocket (Settings > Pickup Addresses), exactly as written there. Orders
# cannot be created in Shiprocket until one exists.
#
# SHIPROCKET_WEBHOOK_TOKEN: a long random string, at least 32 characters
# (openssl rand -hex 24). Paste the same value as the security token in
# Shiprocket > Settings > API > Webhooks, with the URL
# https://<host>/api/public/webhooks/shipping. Tracking updates that do not
# carry it are ignored.
#
# Quote the password in single quotes if it has # or $ in it, and write each
# $ as \$ - an unquoted # starts a comment, and $ starts a variable.
# ---------------------------------------------------------------------------
SHIPROCKET_API_URL="https://apiv2.shiprocket.in"
# SHIPROCKET_EMAIL=""
# SHIPROCKET_PASSWORD=""
# SHIPROCKET_PICKUP_LOCATION=""
# SHIPROCKET_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------------------
# The blog (Sanity). The project id and dataset are in config/site.ts, and
# /studio signs editors in through Sanity itself, so the site shows a public
# dataset's posts with nothing set here.
#
# The console's Blog page - publishing, scheduling and taking posts down -
# needs this: a token with the Editor role, from sanity.io/manage > API >
# Tokens. Drafts cannot be read without one, and publishing is a write. The
# same token lets the site read a dataset that has been made private.
# ---------------------------------------------------------------------------
# SANITY_API_TOKEN=""

# ---------------------------------------------------------------------------
# Mail. REQUIRED IN PRODUCTION: customers have no accounts, so the order
# confirmation is the only record they keep of their order number - and that
# number plus their email is what /track asks for. With no route set the
# mailer no-ops, orders still complete, and buyers are left with nothing.
#
# Every email goes out by the first of three routes that takes it, each used
# only when set (lib/mailer.ts):
#   1. Brevo's API          BREVO_API_KEY                     from BREVO_FROM
#   2. Brevo's SMTP relay   BREVO_SMTP_LOGIN + BREVO_SMTP_KEY from BREVO_FROM
#   3. The shop's Gmail     SMTP_HOST, SMTP_USER, SMTP_PASSWORD from MAIL_FROM
# A route that fails hands the email to the next, so a Brevo outage or a spent
# Brevo quota still gets the receipt out - from the Gmail address.
# ---------------------------------------------------------------------------

# Brevo (app.brevo.com). Its sender must be on a domain authenticated there
# (Senders, domains, IPs > Domains: add the TXT and DKIM/DMARC records it
# lists in Cloudflare's DNS), or Brevo refuses to send as it.
#   API key:  SMTP & API > API keys & MCP > Generate API key (starts xkeysib-)
#   SMTP:     SMTP & API > SMTP > Generate a new SMTP key (starts xsmtpsib-);
#             the login is the "Login" shown on that tab, e.g. 9a8b7c001@smtp-brevo.com
# The free plan sends 300 emails a day across both. If "Block unauthorized IP
# addresses" is on in Brevo's Security settings, add this server's IP to the
# Authorized IPs there, or every API call comes back 401.
# BREVO_API_KEY=""
# BREVO_SMTP_LOGIN=""
# BREVO_SMTP_KEY=""
BREVO_FROM="SKELMET <no-reply@skelmet.in>"

# Where replies go, on every route. Nobody reads no-reply@, so point this at
# a mailbox someone does; unset, a reply goes to the sender.
# MAIL_REPLY_TO="SKELMET <contact@skelmet.in>"

# The shop's Gmail, the last route.
# SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
MAIL_FROM="SKELMET <skelmetindia@gmail.com>"

# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER the full address
# and SMTP_PASSWORD a 16-character App Password (not the account password; it
# needs 2-Step Verification switched on). MAIL_FROM MUST be that same mailbox
# or a verified "Send mail as" alias - Gmail will not send as an address it
# cannot prove you own, so pointing this at orders@skelmet.in before that alias
# exists gets the message rejected. Free Gmail also caps sending near 500
# recipients a day, which is a ceiling worth knowing before a launch.

# ---------------------------------------------------------------------------
# The backend switch. With "1", DATABASE_URL and AUTH_SECRET become required
# and boot fails without them. SET IT TO "1" IN PRODUCTION. It is left off
# here only so a fresh copy boots the marketing pages with no database.
# ---------------------------------------------------------------------------
# REQUIRE_BACKEND="1"

# ---------------------------------------------------------------------------
# Setting up a database: `pnpm db:bootstrap` (prisma/bootstrap.ts) is the
# safe one - it only adds what is missing: permissions, the Admin role, the
# first admin below (who must pick a new password at first sign-in) and the
# catalogue's variants. It never deletes anything.
#
# `pnpm db:seed` does the same for a development database. Its destructive
# reset - wiping the catalogue, order lines, reviews, roles and permissions -
# only runs with SEED_RESET=1, and only against localhost unless
# SEED_I_KNOW_WHAT_I_AM_DOING=1. Never point that at a live database; use
# `pnpm db:sync-permissions` for permission changes instead (§6).
#
# SEED_ADMIN_PASSWORD is required for anything but a localhost database.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@skelmet.in"
# SEED_ADMIN_PASSWORD=""
# SEED_RESET=""
# SEED_I_KNOW_WHAT_I_AM_DOING=""
