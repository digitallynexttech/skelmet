# SKELMET - copy to `.env` and fill in. Never commit `.env`.
# lib/env.ts validates this at boot. Copied as is, it boots the storefront with
# no database (checkout and the console answer 503). Empty counts as unset;
# uncomment a line when you give it a value.

# --- Database (Postgres) ---
# Apply migrations with `pnpm db:migrate`, never `prisma migrate dev` (needs
# shadow-database rights). Setting DATABASE_URL makes AUTH_SECRET required.
# DATABASE_URL="postgresql://skelmet:<password>@127.0.0.1:5432/skelmet?schema=public"

# --- Auth.js ---
# AUTH_SECRET: `openssl rand -base64 32`. Rotating it signs everyone out and
# makes secrets saved in Settings unreadable until re-entered.
# AUTH_URL must match the browsed origin, port included, or sign-in silently
# bounces. Production: https://skelmet.in.
# AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# The site's own address: email links, webhook URLs, Secure cookies.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Payments (Razorpay) ---
# Keys saved in Settings > Payments win over these. Without keys checkout says
# payments are unavailable.
# PAYMENT_WEBHOOK_SECRET is separate from the key secret: shown once when you
# add the webhook in Razorpay. Without it every webhook is rejected.
# PAYMENT_KEY_ID="rzp_test_..."
# PAYMENT_KEY_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# --- Shipping (Shiprocket) ---
# Optional (else courier and AWB are typed by hand); also settable in
# Settings > Shiprocket. The login is an API user (Settings > API > API Users)
# whose email differs from the main login.
# API URL: https://apiv2.shiprocket.in live, https://api-sandbox.shiprocket.in sandbox.
# PICKUP_LOCATION: the exact name of a pickup address in Shiprocket.
# WEBHOOK_TOKEN: 32+ random chars (`openssl rand -hex 24`), pasted as the
# security token in Shiprocket > API > Webhooks for
# https://<host>/api/public/webhooks/shipping.
# A password with # or $: single-quote it and write each $ as \$.
SHIPROCKET_API_URL="https://apiv2.shiprocket.in"
# SHIPROCKET_EMAIL=""
# SHIPROCKET_PASSWORD=""
# SHIPROCKET_PICKUP_LOCATION=""
# SHIPROCKET_WEBHOOK_TOKEN=""

# --- Blog (Sanity; project id in config/site.ts) ---
# Needed for the console's Blog page and a private dataset: an Editor-role
# token from sanity.io/manage > API > Tokens.
# SANITY_API_TOKEN=""

# --- Mail. REQUIRED IN PRODUCTION: the confirmation is the buyer's only record
# of their order number. With no route set the mailer does nothing.
# Routes, tried in order, each only when set (a failure falls to the next):
#   1. Brevo API   BREVO_API_KEY                      from BREVO_FROM
#   2. Brevo SMTP  BREVO_SMTP_LOGIN + BREVO_SMTP_KEY  from BREVO_FROM
#   3. Gmail       SMTP_HOST, SMTP_USER, SMTP_PASSWORD from MAIL_FROM

# Brevo: the sender's domain must be authenticated in Brevo (DNS records in
# Cloudflare). API key: SMTP & API > API keys (xkeysib-). SMTP key and login:
# SMTP & API > SMTP (xsmtpsib-; login like 9a8b7c001@smtp-brevo.com).
# If Brevo blocks unauthorised IPs, authorise this server's IP or calls get 401.
# BREVO_API_KEY=""
# BREVO_SMTP_LOGIN=""
# BREVO_SMTP_KEY=""
BREVO_FROM="SKELMET <no-reply@skelmet.in>"

# Reply-to on every route; unset, replies go to the sender.
# MAIL_REPLY_TO="SKELMET <contact@skelmet.in>"

# Gmail: SMTP_USER the full address, SMTP_PASSWORD a 16-char App Password
# (needs 2-Step Verification). MAIL_FROM must be that mailbox or a verified
# "Send mail as" alias, or Gmail rejects it. Free Gmail caps ~500 recipients/day.
# SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
MAIL_FROM="SKELMET <skelmetindia@gmail.com>"

# --- Backend switch. SET TO "1" IN PRODUCTION: makes DATABASE_URL and
# AUTH_SECRET required at boot.
# REQUIRE_BACKEND="1"

# --- Database setup ---
# `pnpm db:bootstrap` only adds what is missing (permissions, Admin role, the
# first admin below, variants); safe on a live database.
# `pnpm db:seed` is for development. SEED_RESET=1 wipes data, and only runs
# against localhost unless SEED_I_KNOW_WHAT_I_AM_DOING=1. Never on live; use
# `pnpm db:sync-permissions` there.
# SEED_ADMIN_PASSWORD is required except on localhost.
SEED_ADMIN_EMAIL="admin@skelmet.in"
# SEED_ADMIN_PASSWORD=""
# SEED_RESET=""
# SEED_I_KNOW_WHAT_I_AM_DOING=""
