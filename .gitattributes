# Every text file is committed with LF, whatever the checkout machine does.
# The deploy server builds from the repository, and a CRLF shell script or
# SQL migration there fails in ways that do not show up on Windows.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.ttf binary
*.woff2 binary
*.ico binary
*.pdf binary
*.mp4 binary
