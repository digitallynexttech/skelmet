{
  "name": "skelmet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:sync-permissions": "tsx prisma/sync-permissions.ts",
    "mail:test": "tsx scripts/test-mail.ts",
    "assets:icons": "node scripts/build-app-icons.mjs",
    "assets:brand": "node scripts/build-brand-assets.mjs",
    "assets:colourway-cards": "node scripts/build-colourway-cards.mjs",
    "assets:colourway-shots": "node scripts/build-colourway-shots.mjs",
    "assets:ghost-shots": "node scripts/build-ghost-shots.mjs",
    "assets:hero-poster": "node scripts/build-hero-poster.mjs",
    "assets:skull-model": "node scripts/build-skull-model.mjs",
    "assets:skull-plates": "node scripts/build-skull-plates.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sanity/image-url": "^2.1.1",
    "@tanstack/react-query": "^5.102.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-sanity": "^13.3.4",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.16.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
