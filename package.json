    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
