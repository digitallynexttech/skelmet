// Migrations are hand-written SQL applied with `prisma migrate deploy`, never
// `migrate dev` (needs shadow-DB rights).

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  STAFF
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  /// Cash on delivery, accepted: unpaid but ready to pack.
  CONFIRMED
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
  /// An advance paid online, the rest collected by the courier.
  PARTIAL
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CouponKind {
  PERCENT
  FLAT
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum InquiryStatus {
  NEW
  OPEN
  RESOLVED
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

/// PAUSED: stopped short (daily mail limit or a restart).
enum CampaignStatus {
  SENDING
  PAUSED
  SENT
}

/// PENDING is claimed but not yet confirmed by the mail server.
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  kind             UserKind   @default(CUSTOMER)
  email            String     @unique
  passwordHash     String?    @map("password_hash")
  name             String?
  phone            String?
  marketingOptIn   Boolean    @default(false) @map("marketing_opt_in")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  /// Copied into the session at sign-in; bumping it ends older sessions
  /// (server/session-policy.ts).
  sessionVersion   Int        @default(0) @map("session_version")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  roles         UserRole[]
  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  reviews       Review[]
  auditLogs     AuditLog[]
  visitors      Visitor[]

  @@index([kind])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  scope     String           @unique
  module    String
  label     String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  strapline   String?
  description String?
  basePrice   Decimal       @map("base_price") @db.Decimal(12, 2)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  variants Variant[]
  media    MediaAsset[]
  reviews  Review[]

  @@index([status])
  @@map("products")
}

model Variant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  colourway   String
  sku         String   @unique
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  weightGrams Int?     @map("weight_grams")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  media      MediaAsset[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, colourway])
  @@index([productId])
  @@map("variants")
}

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  /// The object key, never a signed URL (those expire).
  key       String
  alt       String
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
  @@index([variantId])
  @@map("media_assets")
}

/// Copy of the browser's cart, written by the visit tracker so the console
/// sees abandoned baskets.
model Cart {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  anonymousId String?  @map("anonymous_id")
  /// One basket per visitor, not a history.
  visitorId   String?  @unique @map("visitor_id") @db.Uuid
  /// When this basket last reached checkout.
  checkoutAt  DateTime? @map("checkout_at")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitor Visitor?   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  items   CartItem[]

  @@index([userId])
  @@index([anonymousId])
  @@index([expiresAt])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  qty       Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  number          String      @unique
  userId          String?     @map("user_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  /// COD orders are packed while unpaid.
  paymentMethod   PaymentMethod @default(ONLINE) @map("payment_method")
  /// The cash-on-delivery charge. Part of `total`.
  paymentFee      Decimal     @default(0) @map("payment_fee") @db.Decimal(12, 2)
  /// Collected at the door: all of `total` for COD, the balance for PARTIAL,
  /// 0 for ONLINE.
  dueOnDelivery   Decimal     @default(0) @map("due_on_delivery") @db.Decimal(12, 2)
  email           String
  phone           String
  shippingAddress Json        @map("shipping_address")
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  shipping        Decimal     @default(0) @db.Decimal(12, 2)
  tax             Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  couponId        String?     @map("coupon_id") @db.Uuid
  /// Shiprocket's ids, once sent there. Text: we only hand them back.
  shiprocketOrderId    String? @unique @map("shiprocket_order_id")
  shiprocketShipmentId String? @map("shiprocket_shipment_id")
  /// Tax invoice SKM/26-27/0001, sequential per financial year. Number and
  /// date fixed on first generation; emailed once, on delivery.
  invoiceNumber    String?   @unique @map("invoice_number")
  invoicedAt       DateTime? @map("invoiced_at")
  invoiceEmailedAt DateTime? @map("invoice_emailed_at")
  /// Credit note reversing the invoice on refund: CN/26-27/0001, own sequence.
  creditNoteNumber String?   @unique @map("credit_note_number")
  creditedAt       DateTime? @map("credited_at")
  /// Only a visitor who accepted cookies: a visit without consent is never
  /// tied to an order.
  visitorId       String?     @map("visitor_id") @db.Uuid
  placedAt        DateTime?   @map("placed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  visitor  Visitor?    @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  shipment Shipment?

  @@index([userId])
  @@index([status, createdAt])
  @@index([email])
  @@index([couponId])
  @@index([visitorId])
  @@index([paymentMethod])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  qty           Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  nameSnapshot  String   @map("name_snapshot")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  gateway          String
  gatewayOrderId   String        @map("gateway_order_id")
  gatewayPaymentId String?       @map("gateway_payment_id")
  status           PaymentStatus @default(CREATED)
  amount           Decimal       @db.Decimal(12, 2)
  /// "test" or "live": the Razorpay account whose keys verify and refund it.
  /// Null: made with the .env keys.
  mode             String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([gateway, gatewayOrderId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  courier     String
  awb         String?
  /// The courier's own words, e.g. "IN TRANSIT".
  status      String
  /// "shiprocket" when booked through the API, "manual" when typed in.
  provider    String    @default("manual")
  labelUrl    String?   @map("label_url")
  manifestUrl String?   @map("manifest_url")
  pickupScheduledAt DateTime? @map("pickup_scheduled_at")
  /// Courier's estimated delivery.
  etd         DateTime?
  /// When `status` was true. Updates arrive out of order; an older one never
  /// overwrites a newer one.
  statusAt    DateTime? @map("status_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([awb])
  @@map("shipments")
}

model Coupon {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  kind        CouponKind
  value       Decimal    @db.Decimal(12, 2)
  minSubtotal Decimal    @default(0) @map("min_subtotal") @db.Decimal(12, 2)
  maxUses     Int?       @map("max_uses")
  usedCount   Int        @default(0) @map("used_count")
  expiresAt   DateTime?  @map("expires_at")
  /// Archived by staff: hidden in the console and no longer accepted.
  archivedAt  DateTime?  @map("archived_at")
  /// Offered in the cart for the buyer to apply, not only typed in.
  showInCart  Boolean    @default(false) @map("show_in_cart")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  orders Order[]

  @@index([expiresAt])
  @@index([showInCart, archivedAt])
  @@map("coupons")
}

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @map("product_id") @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  authorName String      @map("author_name")
  city      String?
  rating    Int
  title     String
  body      String
  status    ReviewStatus @default(PENDING)
  mediaKey  String?      @map("media_key")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([userId])
  @@map("reviews")
}

model Inquiry {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  topic     String
  orderNumber String?     @map("order_number")
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("inquiries")
}

/// A "Notify me" sign-up. One row per address, lowercased; its dates are the
/// record of consent and its withdrawal.
model Subscriber {
  id             String           @id @default(uuid()) @db.Uuid
  email          String           @unique
  status         SubscriberStatus @default(SUBSCRIBED)
  /// Where the address came from: "drop-list" for the home page form.
  source         String
  /// Signs the unsubscribe link. Never shown in the console.
  token          String           @unique
  subscribedAt   DateTime         @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime?        @map("unsubscribed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  deliveries NewsletterDelivery[]

  @@index([status, subscribedAt])
  @@map("newsletter_subscribers")
}

/// One email sent to the list from the console.
model NewsletterCampaign {
  id         String         @id @default(uuid()) @db.Uuid
  subject    String
  /// Plain text: the email's text part and the console's history.
  body       String
  /// The rich-text editor's document. Null: rebuild from `body`.
  content    Json?
  ctaLabel   String?        @map("cta_label")
  ctaUrl     String?        @map("cta_url")
  status     CampaignStatus @default(SENDING)
  /// Subscribers at send time; later sign-ups are not added.
  recipients Int
  /// The mail server's last error when it stopped short.
  note       String?
  sentById   String?        @map("sent_by_id") @db.Uuid
  sentByEmail String?       @map("sent_by_email")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  finishedAt DateTime?      @map("finished_at")

  deliveries NewsletterDelivery[]

  @@index([createdAt])
  @@map("newsletter_campaigns")
}

/// A newsletter picture, served from /api/public/newsletter/images/<id>. In the
/// database because a deploy resets the checkout and `next start` serves only
/// build-time public files.
model NewsletterImage {
  id          String   @id @default(uuid()) @db.Uuid
  contentType String   @map("content_type")
  data        Bytes
  width       Int
  height      Int
  bytes       Int
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("newsletter_images")
}

/// Claimed before sending, so a resumed campaign never emails anyone twice.
model NewsletterDelivery {
  id           String         @id @default(uuid()) @db.Uuid
  campaignId   String         @map("campaign_id") @db.Uuid
  subscriberId String         @map("subscriber_id") @db.Uuid
  status       DeliveryStatus @default(PENDING)
  error        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  campaign   NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber Subscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@index([subscriberId])
  @@map("newsletter_deliveries")
}

/// Last invoice number per financial year ("26-27"), claimed one at a time so
/// numbers have no gaps or repeats.
model InvoiceCounter {
  fy   String @id
  last Int

  @@map("invoice_counters")
}

/// Console settings, one row per section; .env is the fallback
/// (runtime-settings.ts). Secrets in `value` are sealed with AES-256-GCM.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  module    String
  entityId  String?  @map("entity_id")
  meta      Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([module, createdAt])
  @@index([entityId])
  @@map("audit_logs")
}

/// A storefront visitor. Consent decides the kind:
/// - Accepted: this device for a year (cookie `skm.vid`), with IP, device,
///   source and checkout details, linked to orders.
/// - Declined or not asked: `anonymous`, ONE visit keyed by `anonKey`. No
///   cookie, IP or contact details; never linked to an order or a person.
model Visitor {
  id             String    @id @default(uuid()) @db.Uuid
  anonymous      Boolean   @default(true)
  /// The visit an anonymous row belongs to; null once not anonymous.
  anonKey        String?   @unique @map("anon_key") @db.Uuid
  /// When they tapped Accept: the record of consent.
  consentAt      DateTime? @map("consent_at")
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  visitCount     Int       @default(0) @map("visit_count")
  pageviews      Int       @default(0)
  /// Time the page was visible and in use, not merely open.
  engagedSeconds Int       @default(0) @map("engaged_seconds")

  // Location from the latest visit: place from Cloudflare (by IP), pincode typed.
  ip             String?
  country        String?
  region         String?
  city           String?
  /// From Cloudflare's pincode via India Post. Kept for everyone; the pincode
  /// itself only with consent.
  district       String?
  postalCode     String?   @map("postal_code")
  pincode        String?
  /// Cloudflare's approximate point (often the network hub). Only with consent.
  latitude       Float?
  longitude      Float?

  // Device, from the latest visit.
  userAgent      String?   @map("user_agent")
  deviceType     String?   @map("device_type")
  deviceModel    String?   @map("device_model")
  os             String?
  browser        String?
  screen         String?
  language       String?
  timezone       String?

  // How they first found the shop.
  referrer       String?
  source         String?
  medium         String?
  campaign       String?
  landingPage    String?   @map("landing_page")

  // Contact details, typed at checkout or on an order.
  email          String?
  phone          String?
  name           String?
  userId         String?   @map("user_id") @db.Uuid

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions VisitorSession[]
  events   VisitorEvent[]
  cart     Cart?
  orders   Order[]

  @@index([lastSeenAt])
  @@index([userId])
  @@index([email])
  @@index([phone])
  @@map("visitors")
}

/// One visit: ends after 30 minutes without a page.
model VisitorSession {
  id             String   @id @default(uuid()) @db.Uuid
  visitorId      String   @map("visitor_id") @db.Uuid
  /// The tab's id for this visit (sessionStorage).
  key            String   @db.Uuid
  startedAt      DateTime @default(now()) @map("started_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  pageviews      Int      @default(0)
  engagedSeconds Int      @default(0) @map("engaged_seconds")
  landingPage    String?  @map("landing_page")
  exitPage       String?  @map("exit_page")
  referrer       String?
  source         String?
  medium         String?
  campaign       String?
  ip             String?
  city           String?
  region         String?
  district       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  visitor Visitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  events  VisitorEvent[]

  @@unique([visitorId, key])
  @@index([visitorId, startedAt])
  @@index([startedAt])
  @@map("visitor_sessions")
}

model VisitorEvent {
  /// A view's id is the tracker's, so time on page can be added later.
  id        String   @id @default(uuid()) @db.Uuid
  visitorId String   @map("visitor_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  /// view · cart · checkout · contact · placed · consent
  type      String
  path      String?
  /// For a view, time on the page.
  seconds   Int      @default(0)
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visitor Visitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@map("visitor_events")
}

/// India Post's district and state per pincode, looked up once. A null
/// district caches "no such pincode".
model PincodePlace {
  pincode    String   @id
  district   String?
  state      String?
  lookedUpAt DateTime @default(now()) @map("looked_up_at")

  @@map("pincode_places")
}
