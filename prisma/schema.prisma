// SKELMET - Postgres via Prisma 7 with the pg adapter.
// Migrations are hand-written SQL applied with `prisma migrate deploy` (§6);
// `migrate dev` needs shadow-DB rights most hosted Postgres refuses.

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  STAFF
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CouponKind {
  PERCENT
  FLAT
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum InquiryStatus {
  NEW
  OPEN
  RESOLVED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  kind             UserKind   @default(CUSTOMER)
  email            String     @unique
  passwordHash     String?    @map("password_hash")
  name             String?
  phone            String?
  marketingOptIn   Boolean    @default(false) @map("marketing_opt_in")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  roles         UserRole[]
  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  reviews       Review[]
  auditLogs     AuditLog[]
  visitors      Visitor[]

  @@index([kind])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  scope     String           @unique
  module    String
  label     String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  strapline   String?
  description String?
  basePrice   Decimal       @map("base_price") @db.Decimal(12, 2)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  variants Variant[]
  media    MediaAsset[]
  reviews  Review[]

  @@index([status])
  @@map("products")
}

model Variant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  colourway   String
  sku         String   @unique
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  weightGrams Int?     @map("weight_grams")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  media      MediaAsset[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, colourway])
  @@index([productId])
  @@map("variants")
}

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  /// The object key - never a signed URL, which expires while the row lives (§7).
  key       String
  alt       String
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
  @@index([variantId])
  @@map("media_assets")
}

/// The cart lives in the browser (features/cart/hooks/use-cart.ts). This is
/// its copy, written by the visit tracker as it changes, so the console can
/// see what a visitor put in and never paid for. `updatedAt` is the last time
/// the basket changed.
model Cart {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  anonymousId String?  @map("anonymous_id")
  /// One basket per visitor: the browser's, not a history of them.
  visitorId   String?  @unique @map("visitor_id") @db.Uuid
  /// When this basket last reached the checkout page.
  checkoutAt  DateTime? @map("checkout_at")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitor Visitor?   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  items   CartItem[]

  @@index([userId])
  @@index([anonymousId])
  @@index([expiresAt])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  qty       Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  number          String      @unique
  userId          String?     @map("user_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  /// COD orders are packed while still unpaid, so fulfilment has to know which.
  paymentMethod   PaymentMethod @default(ONLINE) @map("payment_method")
  email           String
  phone           String
  shippingAddress Json        @map("shipping_address")
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  shipping        Decimal     @default(0) @db.Decimal(12, 2)
  tax             Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  couponId        String?     @map("coupon_id") @db.Uuid
  /// Shiprocket's ids for this order, once it has been sent there. Text, not
  /// int: they are Shiprocket's numbers and we only ever hand them back.
  shiprocketOrderId    String? @unique @map("shiprocket_order_id")
  shiprocketShipmentId String? @map("shiprocket_shipment_id")
  /// The tax invoice: its number (SKM/26-27/0001, sequential per financial
  /// year) and date are fixed the first time it is generated, and it is
  /// emailed once, on delivery.
  invoiceNumber    String?   @unique @map("invoice_number")
  invoicedAt       DateTime? @map("invoiced_at")
  invoiceEmailedAt DateTime? @map("invoice_emailed_at")
  /// The visitor who placed it - only ever one who accepted cookies. A visit
  /// made without that consent is never tied to the person behind an order.
  visitorId       String?     @map("visitor_id") @db.Uuid
  placedAt        DateTime?   @map("placed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  visitor  Visitor?    @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  shipment Shipment?

  @@index([userId])
  @@index([status, createdAt])
  @@index([email])
  @@index([couponId])
  @@index([visitorId])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  qty           Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  nameSnapshot  String   @map("name_snapshot")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  gateway          String
  gatewayOrderId   String        @map("gateway_order_id")
  gatewayPaymentId String?       @map("gateway_payment_id")
  status           PaymentStatus @default(CREATED)
  amount           Decimal       @db.Decimal(12, 2)
  /// "test" or "live": which Razorpay account took it, so verifying and
  /// refunding it use that account's keys after the console switches. Null
  /// for payments from before the switch existed, all made with the .env keys.
  mode             String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([gateway, gatewayOrderId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  courier     String
  awb         String?
  /// The courier's own words for where it is - "IN TRANSIT", "OUT FOR DELIVERY".
  status      String
  /// "shiprocket" when booked through the API, "manual" when typed in.
  provider    String    @default("manual")
  labelUrl    String?   @map("label_url")
  manifestUrl String?   @map("manifest_url")
  pickupScheduledAt DateTime? @map("pickup_scheduled_at")
  /// The courier's estimated delivery, when it has given one.
  etd         DateTime?
  /// When `status` was true. Tracking updates arrive out of order; an older
  /// one never overwrites a newer one.
  statusAt    DateTime? @map("status_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([awb])
  @@map("shipments")
}

model Coupon {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  kind        CouponKind
  value       Decimal    @db.Decimal(12, 2)
  minSubtotal Decimal    @default(0) @map("min_subtotal") @db.Decimal(12, 2)
  maxUses     Int?       @map("max_uses")
  usedCount   Int        @default(0) @map("used_count")
  expiresAt   DateTime?  @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  orders Order[]

  @@index([expiresAt])
  @@map("coupons")
}

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @map("product_id") @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  authorName String      @map("author_name")
  city      String?
  rating    Int
  title     String
  body      String
  status    ReviewStatus @default(PENDING)
  mediaKey  String?      @map("media_key")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([userId])
  @@map("reviews")
}

model Inquiry {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  topic     String
  orderNumber String?     @map("order_number")
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("inquiries")
}

/// The last invoice number used in each financial year ("26-27"), claimed
/// one at a time so invoice numbers run in order without gaps or repeats.
model InvoiceCounter {
  fy   String @id
  last Int

  @@map("invoice_counters")
}

/// What the console can change without a deploy: the Razorpay keys, the
/// Shiprocket login, the shipping charge. One row per section, read through
/// features/settings/server/runtime-settings.ts, which falls back to .env for
/// anything not saved here. Secrets inside `value` are sealed with AES-256-GCM
/// (features/settings/server/secret-box.ts), never stored readable.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  module    String
  entityId  String?  @map("entity_id")
  meta      Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([module, createdAt])
  @@index([entityId])
  @@map("audit_logs")
}

/// Someone browsing the storefront, written by the visit tracker
/// (features/visitors). Two kinds, and the difference is consent:
///
/// - Accepted cookies: `anonymous` is false and the row is this device for a
///   year - a cookie (`skm.vid`) finds it again on every visit. It holds the
///   IP address, the device, where they came from, and whatever they typed
///   at checkout, and is linked to their orders.
/// - Refused, or not yet asked: `anonymous` is true and the row is ONE visit,
///   found by the tab's own key (`anonKey`). No cookie, no IP address, no
///   contact details, and never linked to an order or a person.
model Visitor {
  id             String    @id @default(uuid()) @db.Uuid
  anonymous      Boolean   @default(true)
  /// The visit an anonymous row belongs to. Null once it is not anonymous.
  anonKey        String?   @unique @map("anon_key") @db.Uuid
  /// When they tapped Accept: the record of their consent.
  consentAt      DateTime? @map("consent_at")
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  visitCount     Int       @default(0) @map("visit_count")
  pageviews      Int       @default(0)
  /// Time with the page open, in front of them, and in use - not merely open.
  engagedSeconds Int       @default(0) @map("engaged_seconds")

  // Where they are, from their latest visit. The place comes from Cloudflare,
  // which works it out from the IP address; the pincode is one they typed.
  ip             String?
  country        String?
  region         String?
  city           String?
  /// From the pincode Cloudflare places them in, through India Post. Kept
  /// for every visitor, like the city; the pincode itself only with consent.
  district       String?
  postalCode     String?   @map("postal_code")
  pincode        String?

  // What they browse on, from their latest visit.
  userAgent      String?   @map("user_agent")
  deviceType     String?   @map("device_type")
  deviceModel    String?   @map("device_model")
  os             String?
  browser        String?
  screen         String?
  language       String?
  timezone       String?

  // How they first found the shop.
  referrer       String?
  source         String?
  medium         String?
  campaign       String?
  landingPage    String?   @map("landing_page")

  // Who they are, once they say: typed at checkout, or on an order.
  email          String?
  phone          String?
  name           String?
  userId         String?   @map("user_id") @db.Uuid

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions VisitorSession[]
  events   VisitorEvent[]
  cart     Cart?
  orders   Order[]

  @@index([lastSeenAt])
  @@index([userId])
  @@index([email])
  @@index([phone])
  @@map("visitors")
}

/// One visit: from arriving until thirty minutes pass without a page.
model VisitorSession {
  id             String   @id @default(uuid()) @db.Uuid
  visitorId      String   @map("visitor_id") @db.Uuid
  /// The browser tab's own name for this visit, kept in sessionStorage.
  key            String   @db.Uuid
  startedAt      DateTime @default(now()) @map("started_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  pageviews      Int      @default(0)
  engagedSeconds Int      @default(0) @map("engaged_seconds")
  landingPage    String?  @map("landing_page")
  exitPage       String?  @map("exit_page")
  referrer       String?
  source         String?
  medium         String?
  campaign       String?
  ip             String?
  city           String?
  region         String?
  district       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  visitor Visitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  events  VisitorEvent[]

  @@unique([visitorId, key])
  @@index([visitorId, startedAt])
  @@index([startedAt])
  @@map("visitor_sessions")
}

/// What happened on a visit: a page seen (and for how long), the cart
/// changing, checkout reached, details typed, an order placed.
model VisitorEvent {
  /// A page view's id is the tracker's own, so the time spent there can be
  /// added to it later; every other event takes a fresh one.
  id        String   @id @default(uuid()) @db.Uuid
  visitorId String   @map("visitor_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  /// view · cart · checkout · contact · placed · consent
  type      String
  path      String?
  /// For a view, the time spent on that page.
  seconds   Int      @default(0)
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visitor Visitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@map("visitor_events")
}

/// The district and state India Post files a pincode under, looked up once:
/// how a visit's approximate pincode becomes a district. A null district is
/// India Post saying there is no such pincode, remembered so it is not asked
/// again.
model PincodePlace {
  pincode    String   @id
  district   String?
  state      String?
  lookedUpAt DateTime @default(now()) @map("looked_up_at")

  @@map("pincode_places")
}
